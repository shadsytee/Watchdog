@echo off
REM ============================================================
REM  Install-Watchdog.bat  (v5.0)
REM  One-click installer, fully self-contained: creates C:\Watchdog
REM  and writes out Watchdog.ps1, Run-Watchdog.bat AND
REM  Uninstall-Watchdog.bat into it (all embedded below as base64),
REM  adds a Desktop shortcut, then launches Watchdog for the first time.
REM ============================================================

setlocal
set "DEST=C:\Watchdog"

net session >nul 2>&1
if %errorlevel% == 0 goto :isAdmin

powershell -NoProfile -Command "Start-Process -FilePath '%~f0' -Verb RunAs" >nul 2>&1
exit /b

:isAdmin
echo Installing Watchdog to %DEST% ...
if not exist "%DEST%" mkdir "%DEST%"

powershell -NoProfile -ExecutionPolicy Bypass -Command "$c = Get-Content -LiteralPath '%~f0'; $s = ($c | Select-String -Pattern '^::PS1_B64_START$').LineNumber; $e = ($c | Select-String -Pattern '^::PS1_B64_END$').LineNumber; $b64 = ($c[$s..($e-2)] -join ''); [IO.File]::WriteAllBytes('%DEST%\Watchdog.ps1', [Convert]::FromBase64String($b64))"

powershell -NoProfile -ExecutionPolicy Bypass -Command "$c = Get-Content -LiteralPath '%~f0'; $s = ($c | Select-String -Pattern '^::BAT_B64_START$').LineNumber; $e = ($c | Select-String -Pattern '^::BAT_B64_END$').LineNumber; $b64 = ($c[$s..($e-2)] -join ''); [IO.File]::WriteAllBytes('%DEST%\Run-Watchdog.bat', [Convert]::FromBase64String($b64))"

powershell -NoProfile -ExecutionPolicy Bypass -Command "$c = Get-Content -LiteralPath '%~f0'; $s = ($c | Select-String -Pattern '^::UNINST_B64_START$').LineNumber; $e = ($c | Select-String -Pattern '^::UNINST_B64_END$').LineNumber; $b64 = ($c[$s..($e-2)] -join ''); [IO.File]::WriteAllBytes('%DEST%\Uninstall-Watchdog.bat', [Convert]::FromBase64String($b64))"

powershell -NoProfile -ExecutionPolicy Bypass -Command "$ws = New-Object -ComObject WScript.Shell; $lnk = $ws.CreateShortcut([IO.Path]::Combine([Environment]::GetFolderPath('Desktop'), 'Watchdog.lnk')); $lnk.TargetPath = '%DEST%\Run-Watchdog.bat'; $lnk.WorkingDirectory = '%DEST%'; $lnk.IconLocation = 'shell32.dll,13'; $lnk.Description = 'Launch Watchdog'; $lnk.Save()"

echo.
echo Installed. Everything (script, launcher, uninstaller) is in %DEST%.
echo Launching Watchdog for the first time...
start "" "%DEST%\Run-Watchdog.bat"
exit

